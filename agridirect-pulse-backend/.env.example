# Primary DB (Railway auto-provides RAILWAY_DATABASE_URL)
RAILWAY_DATABASE_URL=postgresql://user:pass@host:port/dbname
READ_REPLICA_URL=postgresql://user:pass@replica-host:port/dbname

# JWT
JWT_PRIVATE_KEY_PATH=classpath:certs/private.pem
JWT_PUBLIC_KEY_PATH=classpath:certs/public.pem
JWT_EXPIRATION_MS=86400000

# Agmarknet
AGMARKNET_BASE_URL=https://agmarknet.gov.in
AGMARKNET_CRON=0 0/30 * * * *
